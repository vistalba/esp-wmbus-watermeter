substitutions:
  name: esp-watermeter
  friendly_name: Watermeter
  api_key: !secret esp-watermeter_api_key

esphome:
  name: ${name}
  name_add_mac_suffix: false
  friendly_name: ${friendly_name}
  platformio_options:
    upload_speed: 921600

external_components:
  - source: github://SzczepanLeon/esphome-components@main
    components:
      - wmbus_radio
      - wmbus_meter
      - wmbus_common
      - socket_transmitter

esp32:
  board: esp32-c6-devkitc-1
  variant: esp32c6
  flash_size: 16MB
  framework:
    type: esp-idf

logger:
  level: DEBUG
  logs:
    component: WARN
    wifi: INFO

wifi:
  min_auth_mode: WPA3
  enable_btm: true
  enable_rrm: true
  networks:
    - ssid: !secret wifi_ssid
      password: !secret wifi_password
  reboot_timeout: 5min
  ap:
    ssid: "${friendly_name} Access Point"
    password: !secret fallback_password
    ap_timeout: 3min

captive_portal:

api:
  encryption:
    key: ${api_key}
  reboot_timeout: 600s
  on_client_connected:
    - logger.log: "Home Assistant connected"
  on_client_disconnected:
    - logger.log: "Home Assistant disconnected"

ota:
  - platform: esphome
    password: !secret ota_password
    on_begin:
      - logger.log: "OTA update starting..."
    on_progress:
      - logger.log:
          format: "OTA progress: %.1f%%"
          args: ['x']
    on_end:
      - logger.log: "OTA update completed"
    on_error:
      - logger.log: "OTA error"

safe_mode:

time:
  - platform: homeassistant
    id: homeassistant_time
    on_time_sync:
      - logger.log: "Time synchronized"

i2c:
  id: i2c_bus
  sda: GPIO10
  scl: GPIO8

spi:
  clk_pin: GPIO20
  mosi_pin: GPIO21
  miso_pin: GPIO22

wmbus_radio:
  radio_type: SX1262
  cs_pin: GPIO23
  irq_pin: GPIO7
  busy_pin: GPIO19
  rx_gain: BOOSTED
  rf_switch: false
  has_tcxo: true
# Uncomment for troubleshooting – logs every received frame raw
#  on_frame:
#    - then:
#        - logger.log:
#            format: "Frame! RSSI: %ddBm Daten: %s"
#            args: [frame->rssi(), frame->as_hex().c_str()]

wmbus_meter:
  - id: water
    meter_id: !secret watermeter_id
    type: iperl
    key: !secret watermeter_key
    mode:
      - T1

button:
  - platform: safe_mode
    name: "Safe Mode Boot"
    entity_category: diagnostic
    icon: mdi:restart-alert
  - platform: restart
    name: "Restart"
    id: restart_button
    entity_category: diagnostic
    icon: mdi:restart

sensor:
  - platform: wmbus_meter
    parent_id: water
    field: total_m3
    name: "Water Consumption"
    device_class: water
    unit_of_measurement: "m³"
    accuracy_decimals: 3
    state_class: total_increasing
    icon: mdi:water

  - platform: wmbus_meter
    parent_id: water
    field: max_flow_m3h
    name: "Water Flow Rate"
    device_class: water
    unit_of_measurement: "m³/h"
    accuracy_decimals: 3
    state_class: measurement
    icon: mdi:waves-arrow-left

  - platform: wmbus_meter
    parent_id: water
    field: rssi_dbm
    name: "Water Meter RSSI"
    unit_of_measurement: "dBm"
    device_class: signal_strength
    state_class: measurement
    entity_category: diagnostic

  - platform: internal_temperature
    name: "ESP32 Temperature"
    id: esp_temp
    unit_of_measurement: "°C"
    device_class: temperature
    state_class: measurement
    disabled_by_default: true
    update_interval: 60s
    filters:
      - round: 1
    on_value_range:
      - above: 75.0
        then:
          - logger.log: "WARNING: Device temperature too high!"
      - above: 80.0
        then:
          - logger.log: "CRITICAL: Temperature critical! Restarting..."
          - button.press: restart_button

  - platform: wifi_signal
    name: "WiFi Signal"
    unit_of_measurement: "dBm"
    device_class: signal_strength
    state_class: measurement
    disabled_by_default: true
    update_interval: 60s

  - platform: uptime
    name: "Uptime"
    unit_of_measurement: "s"
    state_class: total_increasing
    disabled_by_default: true
    update_interval: 60s

  - platform: template
    name: "Free Heap"
    entity_category: diagnostic
    state_class: measurement
    unit_of_measurement: "bytes"
    disabled_by_default: true
    update_interval: 60s
    lambda: |-
      return heap_caps_get_free_size(MALLOC_CAP_INTERNAL);

text_sensor:
  - platform: wifi_info
    ip_address:
      name: "IP Address"
      entity_category: diagnostic
      disabled_by_default: true
    ssid:
      name: "SSID"
      entity_category: diagnostic
      disabled_by_default: true
    bssid:
      name: "WiFi MAC"
      entity_category: diagnostic
      disabled_by_default: true

  - platform: template
    name: "Last Update"
    entity_category: diagnostic
    disabled_by_default: true
    update_interval: 60s
    lambda: |-
      auto now = id(homeassistant_time).now();
      if (!now.is_valid()) return std::string("Unknown");
      char buffer[20];
      struct tm timeinfo = now.to_c_tm();
      strftime(buffer, sizeof(buffer), "%Y-%m-%d %H:%M:%S", &timeinfo);
      return std::string(buffer);
